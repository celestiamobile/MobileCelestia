  "targets": [
    {
      "name": "MobileCelestia",
      "id": "979D2F7923FEB1A6005D2592",
      "product": "Products/Celestia.app",
      "product-type": "application",
      "last-swift-migration": "11.3",
      "dependencies": [
        "CelestiaCore",
        { "target": "CelestiaMacBridge", "platforms": [ "maccatalyst" ] },
        { "target": "CelestiaHelper", "platforms": [ "maccatalyst" ] },
        "CelestiaUI",
        "CelestiaFoundation",
        { "target": "NotificationServiceExtension", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Copy Localized Files",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "SH_FILE=$SRCROOT/scripts/copy_localized_files.sh",
            "",
            "chmod +x $SH_FILE",
            "",
            "$SH_FILE",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Copy General Data",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "SH_FILE=$SRCROOT/scripts/copy_general_data.sh",
            "",
            "chmod +x $SH_FILE",
            "",
            "$SH_FILE",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Convert PO",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "SH_FILE=$SRCROOT/scripts/convert_po.sh",
            "",
            "chmod +x $SH_FILE",
            "",
            "$SH_FILE",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed PlugIns",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "AsyncGL",
          "product-name": "AsyncGL",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "async-request",
          "product-name": "AsyncRequest",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "sentry-cocoa",
          "product-name": "Sentry",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES": "Classic",
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES[sdk=macosx*]": "",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Celestia",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "MobileCelestia/Celestia.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "MobileCelestia/Celestia-macOS.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(SHARED_BUILD_NUMBER)",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "INFOPLIST_FILE": "$(TARGET_NAME)/Info.plist",
        "INFOPLIST_FILE[sdk=macosx*]": "$(TARGET_NAME)/Info-macos.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "$(SHARED_BUILD_VERSION)",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-ObjC",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "space.celestia.MobileCelestia",
        "PRODUCT_NAME": "Celestia",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SUPPORTS_MACCATALYST": "YES",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) $(APPSTORE_BUILD_FLAG_$(APPSTORE_BUILD))",
      },
