{
  "organization": "Celestia Development Team",
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "bg",
      "ru",
      "zh_CN",
      "zh_TW",
    ],
