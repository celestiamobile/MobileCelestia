    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "A message that tells the user why the app is requesting add-only access to the user’s photo library.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно е разрешение за запазване в приложението „Photos“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Speichern von Bildschirmfotos in der Fotos-App ist eine Berechtigung erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission is needed to save screenshots to the Photos app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso para guardar capturas de pantalla en la aplicación Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autorisation est nécessaire pour enregistrer les captures d’écran dans l’application Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È necessaria l'autorizzazione per salvare le schermate nell'app Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを「写真」アプリに保存するには、アクセス許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷을 사진 앱에 저장하려면 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária permissão para salvar capturas de tela no aplicativo Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется доступ к приложению «Фото» для сохранения снимков экрана."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将截图保存到“照片”App中需要权限。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將截圖儲存至「照片」App需要許可權。"
          }
        }
      }
    }
